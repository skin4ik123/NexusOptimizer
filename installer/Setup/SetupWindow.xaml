<Window x:Class="NexusOptimizer.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Install Nexus Optimizer"
        Width="860" Height="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#1B1C20"/>
    <SolidColorBrush x:Key="InkSoft" Color="#6B7078"/>
    <SolidColorBrush x:Key="Line" Color="#E3E6EC"/>
    <!-- Teal accent: the colour of the application itself, so the installer
         looks like the thing being installed. -->
    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#0E7C6B" Offset="0"/>
      <GradientStop Color="#2FD4C2" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="28,11"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{StaticResource AccentGrad}" CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.84"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F1F3F8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,5"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,5"/>
    </Style>
  </Window.Resources>

  <Border CornerRadius="14" Background="#FFFFFF" Margin="16" MouseLeftButtonDown="OnDragWindow">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.35" Color="#062A25"/>
    </Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Hero panel -->
      <Border Grid.Column="0" CornerRadius="14,0,0,14">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#08322C" Offset="0"/>
            <GradientStop Color="#0E7C6B" Offset="0.55"/>
            <GradientStop Color="#2FD4C2" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Canvas ClipToBounds="True">
            <Ellipse Width="260" Height="260" Canvas.Left="-90" Canvas.Top="-70" Fill="#12FFFFFF"/>
            <Ellipse Width="180" Height="180" Canvas.Left="180" Canvas.Top="120" Fill="#0DFFFFFF"/>
            <Ellipse Width="320" Height="320" Canvas.Left="60" Canvas.Top="330" Fill="#10FFFFFF"/>
          </Canvas>
          <StackPanel VerticalAlignment="Center" Margin="34,0">
            <Border Width="76" Height="76" CornerRadius="20" HorizontalAlignment="Left"
                    Background="#2EFFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1">
              <TextBlock Text="N" FontSize="42" FontWeight="Bold" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Nexus Optimizer" FontSize="30" FontWeight="SemiBold" Foreground="White"
                       Margin="0,18,0,2" TextWrapping="Wrap"/>
            <TextBlock x:Name="VersionText" Text="version 3.7.0" FontSize="13"
                       Foreground="#9FE3D9"/>
            <TextBlock Text="PDF · Photo · Video · Scanner" FontSize="15" Foreground="#D6F5EF"
                       Margin="0,22,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Smaller files, same look. Originals are always kept."
                       FontSize="12.5" Foreground="#7FCFC2" Margin="0,10,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Right-hand side -->
      <Grid Grid.Column="1" Margin="36,22,30,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <TextBlock x:Name="HeaderText" Text="Install" FontSize="22" FontWeight="SemiBold"
                     Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
          <Button x:Name="CloseButton" Content="✕" FontSize="14" Width="34" Height="30"
                  HorizontalAlignment="Right" VerticalAlignment="Top"
                  Style="{StaticResource Ghost}" Padding="0" Click="OnClose"/>
        </Grid>

        <!-- Page 1: options. The scroll viewer is not decoration: the set of
             rows changes (a note about a previous installation appears, the
             licence expands) and without it the bottom of the page, Install
             button included, would be cut off by the window edge. -->
        <ScrollViewer x:Name="OptionsPage" Grid.Row="1" Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">
          <TextBlock Text="Installation mode" FontSize="13" Foreground="{StaticResource InkSoft}"/>
          <RadioButton x:Name="PerUserRadio" IsChecked="True" Checked="OnScopeChanged"
                       Content="Just for me — no administrator rights needed (recommended)"/>
          <RadioButton x:Name="PerMachineRadio" Checked="OnScopeChanged"
                       Content="For all users — administrator rights required"/>

          <TextBlock Text="Install folder" FontSize="13" Foreground="{StaticResource InkSoft}"
                     Margin="0,14,0,4"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" FontSize="13" Padding="8,7" BorderBrush="{StaticResource Line}"
                     Foreground="{StaticResource Ink}" TextChanged="OnPathEdited"/>
            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                    Click="OnBrowse"/>
          </Grid>
          <TextBlock x:Name="PathError" Foreground="#DC2626" FontSize="12" Margin="0,4,0,0"
                     TextWrapping="Wrap" Visibility="Collapsed"/>
          <TextBlock x:Name="ContextNote" Foreground="{StaticResource InkSoft}" FontSize="12"
                     Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

          <CheckBox x:Name="DesktopCheck" IsChecked="True" Margin="0,14,0,0"
                    Content="Add a desktop shortcut"/>
          <CheckBox x:Name="MenuCheck" IsChecked="True"
                    Content="Add &quot;Compress&quot; to the Explorer menu"/>
          <TextBlock x:Name="MenuNote" FontSize="11.5" Foreground="{StaticResource InkSoft}"
                     Margin="24,0,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                     Text="On Windows 11 24H2 this menu is system-wide: Windows will ask for confirmation once. Declining is fine — &quot;Send to&quot; keeps working."/>
          <CheckBox x:Name="LaunchCheck" IsChecked="True"
                    Content="Launch Nexus Optimizer after installation"/>

          <Expander Margin="0,12,0,0" Foreground="{StaticResource InkSoft}">
            <Expander.Header>
              <TextBlock Text="Licence agreement" FontSize="13"/>
            </Expander.Header>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6"
                    Margin="0,6,0,0" Padding="10" MaxHeight="120">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LicenseText" FontSize="12" Foreground="{StaticResource Ink}"
                           TextWrapping="Wrap"/>
              </ScrollViewer>
            </Border>
          </Expander>

          <Grid Margin="0,18,0,0">
            <TextBlock Text="By clicking Install you accept the terms of the agreement."
                       FontSize="11.5" Foreground="{StaticResource InkSoft}"
                       VerticalAlignment="Center"/>
            <Button Content="Install" Style="{StaticResource Primary}"
                    HorizontalAlignment="Right" Click="OnInstall"/>
          </Grid>
        </StackPanel>
        </ScrollViewer>

        <!-- Page 2: progress -->
        <StackPanel x:Name="ProgressPage" Grid.Row="1"
                    VerticalAlignment="Center" Visibility="Collapsed">
          <TextBlock x:Name="ProgressStatus" Text="Preparing…" FontSize="16"
                     Foreground="{StaticResource Ink}" HorizontalAlignment="Center"/>
          <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" Height="6" Margin="20,22"
                       Foreground="{StaticResource AccentGrad}" BorderThickness="0"
                       Background="#EDEFF5"/>
          <TextBlock Text="This usually takes less than a minute" FontSize="12.5"
                     Foreground="{StaticResource InkSoft}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Page 3: done -->
        <StackPanel x:Name="DonePage" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
          <Border Width="72" Height="72" CornerRadius="36" Background="#E3F7F2"
                  HorizontalAlignment="Center">
            <TextBlock Text="✓" FontSize="38" FontWeight="Bold" Foreground="#0E7C6B"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Done!" FontSize="24" FontWeight="SemiBold"
                     Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,16,0,4"/>
          <TextBlock x:Name="DoneText" Text="Nexus Optimizer is installed and ready to use."
                     FontSize="14" Foreground="{StaticResource InkSoft}" HorizontalAlignment="Center"
                     TextWrapping="Wrap" TextAlignment="Center"/>
          <TextBlock x:Name="MenuResultText" FontSize="12.5" Foreground="{StaticResource InkSoft}"
                     HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                     Margin="0,10,0,0" Visibility="Collapsed"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
            <Button x:Name="LaunchButton" Content="Launch Nexus Optimizer" Style="{StaticResource Primary}"
                    Click="OnLaunch"/>
            <Button Content="Close" Style="{StaticResource Ghost}" Margin="10,0,0,0"
                    Click="OnClose"/>
          </StackPanel>
        </StackPanel>

        <!-- Page 4: failure -->
        <StackPanel x:Name="ErrorPage" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
          <Border Width="72" Height="72" CornerRadius="36" Background="#FDEBEB"
                  HorizontalAlignment="Center">
            <TextBlock Text="✕" FontSize="34" FontWeight="Bold" Foreground="#DC2626"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Installation did not finish" FontSize="20" FontWeight="SemiBold"
                     Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,16,0,6"/>
          <TextBlock x:Name="ErrorText" FontSize="13" Foreground="{StaticResource InkSoft}"
                     HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
            <Button Content="Copy report" Style="{StaticResource Ghost}" Click="OnCopyReport"/>
            <Button Content="Retry" Style="{StaticResource Ghost}" Margin="10,0,0,0"
                    Click="OnRetry"/>
            <Button Content="Close" Style="{StaticResource Ghost}" Margin="10,0,0,0"
                    Click="OnClose"/>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
